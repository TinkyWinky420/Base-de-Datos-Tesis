<div class="contenedor">

  <div class="cabecera-tesis">

    <h1 class="titulo">
      Eliminar tesis
    </h1>

    <div class="datos-generales">

      <div class="dato">
        <span class="etiqueta">Título:</span>
        <span class="valor"><%= @nombre.titulo %></span>
      </div>

      <div class="dato">
        <span class="etiqueta">Número de control:</span>
        <span class="valor"><%= @nombre.numero_control %></span>
      </div>

    </div>

  </div>

  <div class="seccion">

    <h2>Confirmación de seguridad</h2>

    <div class="contenido-seccion">

      <p>
        Para confirmar la eliminación de la tesis, ingrese la clave de seguridad.
      </p>

      <% if flash[:alert] %>

        <div class="mensaje-error">
          <%= flash[:alert] %>
        </div>

      <% end %>

      <%= form_with url: confirmar_eliminacion_nombre_path(@nombre),
              method: :post,
              local: true,
              data: { turbo: false } do %>
        <%= hidden_field_tag :motivo, params[:motivo] %>

        <div class="campo">

          <%= label_tag :clave, "Clave de seguridad" %>

          <%= password_field_tag :clave,
          nil,
          required: true,
          placeholder: "Ingrese la clave" %>

        </div>

        <div class="acciones">

          <%= link_to "Cancelar",
          nombre_path(@nombre),
          class: "btn" %>

          <%= submit_tag "Eliminar tesis",
          class: "btn btn-danger" %>

        </div>

      <% end %>

    </div>

  </div>

</div>