<div class="contenedor visor-contenedor">

  <div class="cabecera-tesis">

    <h1 class="titulo">
      <%= @nombre.titulo %>
    </h1>

    <div class="datos-generales">

      <div class="dato">
        <span class="etiqueta">Número de control:</span>
        <span class="valor"><%= @nombre.numero_control %></span>
      </div>

      <div class="dato">
        <span class="etiqueta">Archivo:</span>
        <span class="valor"><%= @nombre.documento.filename %></span>
      </div>

    </div>

    <div class="visor-botones">

      <%= link_to "Volver",
      nombre_path(@nombre),
      class: "btn" %>

      <% if ["asesor","administrativo"].include?(session[:rol]) %>

        <%= button_to "Descargar documento",
        descargar_documento_nombre_path(@nombre),
        method: :post,
        class: "btn" %>

      <% end %>

    </div>

  </div>

  <div class="seccion">

    <h2>Vista previa del documento</h2>

    <div class="visor-pdf">

      <iframe
      src="<%= rails_blob_path(@nombre.documento, disposition: "inline") %>#toolbar=0&navpanes=0&scrollbar=1"
      width="100%"
      height="900">
      </iframe>

    </div>

  </div>

</div>