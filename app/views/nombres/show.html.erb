<p class="notice"><%= notice %></p>

<div class="contenedor">

  <div class="cabecera-tesis">

    <h1 class="titulo"><%= @nombre.titulo %></h1>

    <div class="datos-generales">

      <div class="dato">
        <span class="etiqueta">NUMERO DE CONTROL: </span>
        <span class="valor"><%= @nombre.numero_control %></span>
      </div>

      <div class="dato">
        <span class="etiqueta">CARRERA: </span>
        <span class="valor"><%= @nombre.carrera %></span>
      </div>

    </div>

  </div>

  <div class="seccion">

    <h2>Descripción</h2>

    <div class="contenido-seccion">
      <p><%= @nombre.descripcion %></p>
    </div>

  </div>

  <div class="seccion">

    <h2>Integrantes</h2>

    <div class="contenido-seccion">

      <% @nombre.integrantes.each do |i| %>

        <div class="integrante">

          <p>
            <strong>Nombre:</strong>
            <span class="dato-resaltado"><%= i.nombre %></span>
          </p>

          <p>
            <strong>Matrícula:</strong>
            <span class="dato-resaltado"><%= i.matricula %></span>
          </p>

        </div>

      <% end %>

      <% if @nombre.integrantes.empty? %>
        <p>No hay integrantes registrados.</p>
      <% end %>

    </div>

  </div>

  <div class="seccion">

    <h2>Asesores</h2>

    <div class="contenido-seccion">

      <% @nombre.asesores.each do |a| %>

        <div class="asesor">

          <p>
            <strong>Nombre:</strong>
            <span class="dato-resaltado"><%= a.nombre %></span>
          </p>

        </div>

      <% end %>

      <% if @nombre.asesores.empty? %>
        <p>No hay asesores registrados.</p>
      <% end %>

    </div>

  </div>

  <div class="seccion">

    <h2>Documento</h2>

    <div class="contenido-seccion">

      <% if @nombre.documento.attached? %>

        <p>
          <strong>Archivo:</strong>
          <span class="dato-resaltado">
            <%= @nombre.documento.filename %>
          </span>
        </p>

        <% if @nombre.es_pdf? %>

          <div style="margin-top:20px;">
            <%= link_to "Ver documento",
            documento_nombre_path(@nombre),
            class: "btn" %>
          </div>

        <% end %>

      <% else %>

        <p>No hay documento registrado.</p>

      <% end %>

    </div>

  </div>

  <div class="acciones">

    <%= link_to "Volver a tesis",
    nombres_path,
    class: "btn" %>

    <%= link_to "Eliminar tesis",
    motivo_nombre_path(@nombre),
    class: "btn btn-danger" %>

  </div>

</div>