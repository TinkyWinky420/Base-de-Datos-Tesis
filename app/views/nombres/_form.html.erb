<%= form_with(model: nombre, local: true, html: { novalidate: true }) do |form| %>

<% if nombre.errors.any? %>
<div class="errores-formulario">

<% orden = [
"Se requiere agregar Título",
"Se requiere agregar Descripción",
"Se requiere elegir Carrera",
"Se requiere agregar Nombre del Integrante",
"Se requiere agregar Matrícula",
"Se requiere agregar Nombre del Asesor",
"Se requiere agregar Documento"
] %>

<% orden.each do |mensaje| %>
<% if nombre.errors.map(&:message).include?(mensaje) %>
<p><%= mensaje %></p>
<% end %>
<% end %>

<% nombre.errors.each do |error| %>
<% unless orden.include?(error.message) %>
<p><%= error.message %></p>
<% end %>
<% end %>

</div>
<% end %>

<div class="form-seccion">

<div class="form-seccion-titulo">
<h2>Información general</h2>
<p>Complete los datos principales de la tesis.</p>
</div>

<div class="integrante">

<div class="campo">
<label>
Título <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= form.text_field :titulo,
placeholder: "Ingrese el título de la tesis" %>

</div>

<div class="campo">
<label>
Descripción <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= form.textarea :descripcion,
placeholder: "Describa brevemente la tesis" %>

</div>

</div>

</div>

<div class="form-seccion">

<div class="form-seccion-titulo">
<h2>Carrera y ubicación</h2>
<p>Seleccione la carrera, la zona y el plantel.</p>
</div>

<div class="asesor">

<div class="campo">

<label>
Carrera <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= form.select :carrera,
["Ingeniería en Sistemas Computacionales"],
{ prompt: "Seleccione una carrera" } %>

</div>

<div class="campo">

<label>
Zona <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= form.collection_select :zona,
@zonas,
:nombre,
:nombre,
{ prompt: "Elija su zona" },
{ id: "zona_select" } %>

</div>

<div id="plantel_container" style="display:none;">

<div class="campo">

<label>
Plantel <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= form.select :plantel,
[],
{ prompt: "Elija un plantel" },
{ id: "plantel_select" } %>

</div>

</div>

</div>

</div>

<div class="form-seccion">

<div class="form-seccion-titulo">
<h2>Integrantes</h2>
<p>Agregue todos los integrantes de la tesis.</p>
</div>

<div id="integrantes">

<%= form.fields_for :integrantes do |i| %>

<div class="integrante">

<div class="campo">
<label>
Nombre <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= i.text_field :nombre,
pattern: "[A-Za-záéíóúÁÉÍÓÚñÑ ]+",
placeholder: "Nombre completo",
oninvalid: "this.setCustomValidity('El nombre no puede contener números')",
oninput: "this.setCustomValidity('')" %>

</div>

<div class="campo">
<label>
Matrícula (9 dígitos) <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= i.text_field :matricula,
class: "sin-flechas",
inputmode: "numeric",
maxlength: 9,
placeholder: "Número de matrícula",
pattern: "[0-9]{9}",
oninvalid: "this.setCustomValidity('La matrícula debe contener exactamente 9 dígitos')",
oninput: "this.setCustomValidity('')" %>

</div>

<% if i.object.persisted? %>

<%= link_to "Eliminar integrante",
motivo_integrante_path(i.object),
class: "btn btn-danger" %>

<% end %>

</div>

<% end %>

</div>

<div class="acciones-formulario">

<button type="button" class="btn" onclick="agregarIntegrante()">
Agregar integrante
</button>

</div>

</div>

<div class="form-seccion">

<div class="form-seccion-titulo">
<h2>Asesores</h2>
<p>Seleccione el asesor principal y, si desea, un asesor secundario.</p>
</div>

<div id="asesores">

<% asesores_lista = [
"José Guadalupe Sánchez Hernández",
"Bersain Selvas Díaz",
"Jaime Minor Gómez",
"Erika Maribel Arellano Orozco",
"Delia Azucena Lienzo Vázquez",
"Gerardo Estrada Gutiérrez",
"Benjamín Nájera Espinosa",
"Abraham Eduardo Viggers Virgen",
"José Jovany Martínez Muñoz",
"Eduardo García Castrejón",
"Lic. Eduardo Castrejon",
"Guillermo Torres Linares",
"Eduardo Isaac Juárez Rivero"
] %>

<% first = true %>
<%= form.fields_for :asesores do |a| %>

<div class="asesor">

<div class="campo">

<label>
<%= first ? "Asesor principal" : "Asesor secundario" %> <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= a.select :nombre,
asesores_lista,
{ prompt: "Seleccione un asesor" },
{ required: first, id: first ? "asesor_principal" : nil } %>

</div>

</div>

<% first = false %>
<% end %>

</div>

<div class="acciones-formulario" id="acciones-asesores">

<button type="button" class="btn" onclick="agregarAsesor()">
Agregar asesor secundario
</button>

</div>

</div>

<div class="form-seccion">

<div class="form-seccion-titulo">
<h2>Documento</h2>
<p>Adjunte el archivo de la tesis.</p>
</div>

<div class="asesor">

<div class="campo">

<label>
Subir documento <span class="obligatorio">* OBLIGATORIO</span>
</label>

<%= form.file_field :documento,
accept: ".pdf",
onchange: "validarArchivo(this)" %>

<p style="margin-top:8px; color:#666; font-size:14px;">
El documento debe cargarse únicamente en formato PDF.
</p>

</div>

</div>

</div>

<div class="acciones-finales">

<%= form.submit "Guardar tesis", class: "btn" %>

</div>

<% end %>

<script>

function validarArchivo(input){

const archivo=input.files[0];

if(!archivo)return;

if(archivo.type!=="application/pdf"){
alert("Solo se permiten archivos PDF.");
input.value="";
}

}

function agregarIntegrante(){

const container=document.getElementById("integrantes");
const index=container.querySelectorAll(".integrante").length;

const html=`
<div class="integrante">

<div class="campo">

<label>
Nombre <span class="obligatorio">* OBLIGATORIO</span>
</label>

<input
type="text"
name="nombre[integrantes_attributes][${index}][nombre]"
placeholder="Nombre completo"
pattern="[A-Za-záéíóúÁÉÍÓÚñÑ ]+"
oninvalid="this.setCustomValidity('El nombre no puede contener números')"
oninput="this.setCustomValidity('')">

</div>

<div class="campo">

<label>
Matrícula (9 dígitos) <span class="obligatorio">* OBLIGATORIO</span>
</label>

<input
type="text"
name="nombre[integrantes_attributes][${index}][matricula]"
placeholder="Número de matrícula"
maxlength="9"
inputmode="numeric"
pattern="[0-9]{9}"
oninvalid="this.setCustomValidity('La matrícula debe contener exactamente 9 dígitos')"
oninput="this.setCustomValidity('')">

</div>

</div>
`;

container.insertAdjacentHTML("beforeend",html);

}

var ASESORES=[
"",
"José Guadalupe Sánchez Hernández",
"Bersain Selvas Díaz",
"Jaime Minor Gómez",
"Erika Maribel Arellano Orozco",
"Delia Azucena Lienzo Vázquez",
"Gerardo Estrada Gutiérrez",
"Benjamín Nájera Espinosa",
"Abraham Eduardo Viggers Virgen",
"José Jovany Martínez Muñoz",
"Eduardo García Castrejón",
"Lic. Eduardo Castrejon",
"Guillermo Torres Linares",
"Eduardo Isaac Juárez Rivero"
];

function filtrarSecundario(){
  var principal=document.getElementById("asesor_principal");
  var secundario=document.getElementById("asesor_secundario");
  if(!principal||!secundario)return;
  var val=principal.value;
  var actual=secundario.value;
  secundario.innerHTML="";
  for(var i=0;i<ASESORES.length;i++){
    var opt=document.createElement("option");
    opt.value=ASESORES[i];
    opt.textContent=ASESORES[i]===""?"Seleccione un asesor":ASESORES[i];
    if(ASESORES[i]===val&&val!=="")continue;
    if(ASESORES[i]===actual)opt.selected=true;
    secundario.appendChild(opt);
  }
}

function agregarAsesor(){

var container=document.getElementById("asesores");
var existentes=container.querySelectorAll(".asesor").length;

if(existentes>=2)return;

var index=existentes;

var html='<div class="asesor">'+
'<div class="campo">'+
'<label>Asesor secundario <span class="obligatorio">* OBLIGATORIO</span></label>'+
'<select id="asesor_secundario" name="nombre[asesores_attributes]['+index+'][nombre]" required>'+
'</select>'+
'</div>'+
'</div>';

container.insertAdjacentHTML("beforeend",html);

filtrarSecundario();
document.getElementById("acciones-asesores").style.display="none";

}

function initAsesores(){
  var principal=document.getElementById("asesor_principal");
  if(principal){
    principal.removeEventListener("change",filtrarSecundario);
    principal.addEventListener("change",filtrarSecundario);
  }
}

iniciarFormulario();
initAsesores();
document.addEventListener("turbo:load", function(){ iniciarFormulario(); initAsesores(); });

function iniciarFormulario() {

  const zona = document.getElementById("zona_select");
  const contenedor = document.getElementById("plantel_container");
  const plantel = document.getElementById("plantel_select");

  if (!zona || !contenedor || !plantel) {
    return;
  }

  zona.onchange = function () {

    plantel.innerHTML = '<option value="">Elija un plantel</option>';

    if (zona.value === "") {
      contenedor.style.display = "none";
      return;
    }

    fetch("/zonas/" + encodeURIComponent(zona.value) + "/planteles")
      .then(response => response.json())
      .then(data => {

        contenedor.style.display = "block";

        data.forEach(function(item){

          const opcion = document.createElement("option");

          opcion.value = item.nombre;
          opcion.textContent = item.nombre;

          plantel.appendChild(opcion);

        });

      })
      .catch(function(error){

        console.error("Error al cargar planteles:", error);

        contenedor.style.display = "none";

      });

  };

  if (zona.value !== "" && !plantel.dataset.cargado) {
    plantel.dataset.cargado = "true";
    zona.dispatchEvent(new Event("change"));
  }

}
</script>