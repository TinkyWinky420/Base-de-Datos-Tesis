<div class="contenedor">

  <div class="cabecera-tesis">

    <h1 class="titulo">
      Eliminar integrante
    </h1>

    <div class="datos-generales">

      <div class="dato">
        <span class="etiqueta">Nombre:</span>
        <span class="valor"><%= @integrante.nombre %></span>
      </div>

      <div class="dato">
        <span class="etiqueta">Matrícula:</span>
        <span class="valor"><%= @integrante.matricula %></span>
      </div>

      <% if @integrante.tesis.present? %>

        <div class="dato">
          <span class="etiqueta">Tesis:</span>
          <span class="valor"><%= @integrante.tesis.titulo %></span>
        </div>

      <% end %>

    </div>

  </div>

  <div class="seccion">

    <h2>Motivo de la eliminación</h2>

    <div class="contenido-seccion">

      <p>
        Escriba el motivo por el cual desea eliminar este integrante.
      </p>

<%= form_with url: verificar_motivo_integrante_path(@integrante),
              method: :post,
              local: true,
              data: { turbo: false } do %>

        <div class="campo">

          <%= label_tag :motivo, "Motivo" %>

          <%= text_area_tag :motivo,
          nil,
          rows: 6,
          required: true,
          placeholder: "Escriba aquí el motivo de la eliminación..." %>

        </div>

        <div class="acciones">

          <% destino = @integrante.tesis.present? ? edit_nombre_path(@integrante.tesis) : nombres_path %>

          <%= link_to "Cancelar",
          destino,
          class: "btn" %>

          <%= submit_tag "Continuar",
          class: "btn btn-danger" %>

        </div>

      <% end %>

    </div>

  </div>

</div>
