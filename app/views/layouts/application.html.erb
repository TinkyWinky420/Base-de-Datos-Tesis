<!DOCTYPE html>
<html>
  <head>
    <title>UTC</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  </head>

  <body>

    <header class="topbar">

      <div class="topbar-left">

        <button id="menu-toggle" class="menu-toggle">
          <i class="bi bi-list"></i>
        </button>

        <div class="topbar-logo">
          <h1>UTC</h1>
          <span>Universidad Tres Culturas</span>
        </div>

      </div>

      <div class="topbar-user">

        <% if modo_solo_lectura? %>

          <span class="badge-solo-lectura">Solo lectura</span>

        <% elsif session[:rol].present? %>

          <div class="dropdown">

            <button class="btn">
              <%= session[:rol].capitalize %>
            </button>

            <div class="dropdown-content">
              <%= link_to "Cerrar sesión", logout_path %>
            </div>

          </div>

        <% else %>

          <%= link_to "Acceder", login_path, class: "btn" %>

        <% end %>

      </div>

    </header>

    <div class="layout">

      <aside id="sidebar" class="sidebar">

        <%= link_to root_path, class: "sidebar-btn" do %>
          <span class="icono">
            <i class="bi bi-house-door"></i>
          </span>
          <span class="texto">Inicio</span>
        <% end %>

        <% unless controller_name == "sesiones" %>

          <% unless modo_solo_lectura? %>

            <%= link_to new_nombre_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-file-earmark-plus"></i>
              </span>
              <span class="texto">Registrar tesis</span>
            <% end %>

          <% end %>

          <% if session[:rol] == "alumno" %>

            <%= link_to revisar_nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-person-badge"></i>
              </span>
              <span class="texto">Revisar mi tesis</span>
            <% end %>

            <%= link_to buscar_nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-search"></i>
              </span>
              <span class="texto">Buscar tesis</span>
            <% end %>

          <% elsif session[:rol] == "asesor" %>

            <%= link_to nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-journal-bookmark"></i>
              </span>
              <span class="texto">Listado de tesis</span>
            <% end %>

            <%= link_to buscar_nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-search"></i>
              </span>
              <span class="texto">Buscar tesis</span>
            <% end %>

            <%= link_to historial_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-clock-history"></i>
              </span>
              <span class="texto">Historial</span>
            <% end %>

            <%= link_to estadisticas_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-bar-chart-fill"></i>
              </span>
              <span class="texto">Estadísticas</span>
            <% end %>

          <% elsif session[:rol] == "administrativo" %>

            <%= link_to nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-journal-bookmark"></i>
              </span>
              <span class="texto">Listado de tesis</span>
            <% end %>

            <%= link_to buscar_nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-search"></i>
              </span>
              <span class="texto">Buscar tesis</span>
            <% end %>

            <%= link_to historial_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-clock-history"></i>
              </span>
              <span class="texto">Historial</span>
            <% end %>

            <%= link_to estadisticas_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-bar-chart-fill"></i>
              </span>
              <span class="texto">Estadísticas</span>
            <% end %>

            <%= link_to zonas_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-geo-alt"></i>
              </span>
              <span class="texto">Zonas y Planteles</span>
            <% end %>

            <%= link_to plantel_carreras_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-diagram-3"></i>
              </span>
              <span class="texto">Carreras por plantel</span>
            <% end %>

          <% else %>

            <%= link_to nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-journal-bookmark"></i>
              </span>
              <span class="texto">Listado de tesis</span>
            <% end %>

            <%= link_to buscar_nombres_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-search"></i>
              </span>
              <span class="texto">Buscar tesis</span>
            <% end %>

            <%= link_to historial_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-clock-history"></i>
              </span>
              <span class="texto">Historial</span>
            <% end %>

            <%= link_to estadisticas_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-bar-chart-fill"></i>
              </span>
              <span class="texto">Estadísticas</span>
            <% end %>

            <%= link_to zonas_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-geo-alt"></i>
              </span>
              <span class="texto">Zonas y Planteles</span>
            <% end %>

            <%= link_to plantel_carreras_path, class: "sidebar-btn" do %>
              <span class="icono">
                <i class="bi bi-diagram-3"></i>
              </span>
              <span class="texto">Carreras por plantel</span>
            <% end %>

          <% end %>

        <% end %>

      </aside>

      <main class="contenido">
        <%= yield %>
      </main>

    </div>

    <script>
      function inicializarMenu() {
        const boton = document.getElementById("menu-toggle");
        const sidebar = document.getElementById("sidebar");

        if (!boton || !sidebar) {
          return;
        }

        boton.onclick = function () {
          sidebar.classList.toggle("expandido");
        };
      }

      inicializarMenu();
      document.addEventListener("turbo:load", inicializarMenu);
    </script>

  </body>
</html>